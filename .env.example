# Copy this file to .env and you are done:
#
#   cp .env.example .env && docker compose up
#
# .env is git-ignored; this file is committed. That is the whole convention — the
# repo tells you which variables exist without ever telling you their values.
# These defaults are deliberately boring local-development ones. A real deployment
# gets a real password from somewhere that is not a text file.

# --- the database container (read by compose.yaml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev
POSTGRES_DB=tasks

# --- the app ---
PORT=3000

# Only used when you run the app on your machine (`npm start`) or run the tests.
# Under `docker compose up` the api service gets its own DATABASE_URL pointing at
# host `db` instead of `localhost`, because inside the compose network the
# database is a neighbouring container, not this machine.
DATABASE_URL=postgres://postgres:dev@localhost:5432/tasks
