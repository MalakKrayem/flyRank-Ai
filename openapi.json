{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "description": "A small CRUD API for a to-do list, with user accounts on top. Tasks are stored in a PostgreSQL database running in a Docker container, so they survive a restart of the server and a rebuild of its container. Accounts live in Supabase Auth, which hashes the passwords and signs the tokens \u2014 this API never does either.\n\nRoutes marked with a padlock need a bearer token. To use them here: call `POST /auth/login`, copy the `access_token` out of the response, click **Authorize** at the top of this page and paste it in. Every locked route below will then send it for you.\n\nThe whole stack starts with `docker compose up`."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Sign up, log in, log out \u2014 handled by Supabase Auth"
    },
    {
      "name": "Protected",
      "description": "Routes that answer only for a verified bearer token"
    },
    {
      "name": "Public",
      "description": "Routes that answer for anyone, with no token at all"
    },
    {
      "name": "Tasks",
      "description": "Create, read, update and delete tasks"
    },
    {
      "name": "Meta",
      "description": "Service information and health"
    }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an account",
        "description": "Registers a new user with Supabase Auth. The password is sent straight to Supabase, which hashes and stores it \u2014 this API never sees a stored password and never hashes anything itself.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "`email` or `password` missing from the body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Supabase refused the credentials \u2014 an address that is not an address, or a password under six characters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in and get a token",
        "description": "Exchanges credentials for a signed JWT. Copy the `access_token` from the response into the **Authorize** dialog at the top of this page to use the locked routes below.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "`email` or `password` missing from the body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Wrong password, or no such account. Deliberately the same message for both \u2014 telling them apart would let anyone discover which addresses have accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "End the session",
        "description": "Revokes the session behind the presented token. Protected, because you cannot end a session without proving you are in it.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out. Nothing to say about it."
          },
          "401": {
            "description": "No token, a malformed `Authorization` header, or a token Supabase rejected as invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/protected/profile": {
      "get": {
        "tags": [
          "Protected"
        ],
        "summary": "Read your own profile",
        "description": "Returns the account behind the token. The token is verified with Supabase on every call, so the answer is about whoever the token really belongs to \u2014 not whoever the client claims to be.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The verified user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, a malformed `Authorization` header, or a token Supabase rejected as invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/protected/dashboard": {
      "get": {
        "tags": [
          "Protected"
        ],
        "summary": "A second protected route",
        "description": "Exists to prove the guard is reusable: it was added without one new line of auth code, and is protected purely by sitting behind the same middleware as `/protected/profile`.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The verified user, greeted by name.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Welcome back, you@example.com."
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No token, a malformed `Authorization` header, or a token Supabase rejected as invalid or expired.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/public/info": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Public information",
        "description": "Open to anyone. Useful as the control in the experiment: when a protected route answers 401, this one proves the server itself is reachable.",
        "responses": {
          "200": {
            "description": "The public message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Welcome stranger! This info is public."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Describe the API",
        "responses": {
          "200": {
            "description": "Name, version and available endpoints",
            "content": {
              "application/json": {
                "example": {
                  "name": "Task API",
                  "version": "1.0",
                  "endpoints": [
                    "/tasks"
                  ],
                  "docs": "/docs"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Check that the server is alive and can reach its database",
        "description": "Runs `SELECT 1` against Postgres rather than only reporting that the process is running. This is the endpoint a load balancer or orchestrator polls: 200 means \"send me traffic\", 503 means \"take me out of rotation\".",
        "responses": {
          "200": {
            "description": "The server is up and the database answered",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "db": "ok"
                }
              }
            }
          },
          "503": {
            "description": "The server is running but cannot reach the database",
            "content": {
              "application/json": {
                "example": {
                  "status": "degraded",
                  "db": "unreachable",
                  "error": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Count tasks by state",
        "responses": {
          "200": {
            "description": "Totals computed from the current list",
            "content": {
              "application/json": {
                "example": {
                  "total": 3,
                  "done": 1,
                  "open": 2
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "List tasks",
        "description": "Returns every task. Use `done` and `search` to filter, `sort` to order them, and `limit`/`offset` to page through the results. All of it is done in SQL.",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "description": "Only return finished (`true`) or unfinished (`false`) tasks.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Only return tasks whose title contains this text (case-insensitive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Order the results by insertion order (`id`, the default) or alphabetically by title (`title`, case-insensitive).",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "title"
              ],
              "default": "id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of tasks to return.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of tasks to skip before returning results.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter was invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Create a task",
        "description": "The server assigns the id and sets `done` to false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Buy milk"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Title is missing or empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Field \"title\" is required and must be a non-empty string"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The task's id.",
          "schema": {
            "type": "integer",
            "example": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get one task",
        "responses": {
          "200": {
            "description": "The task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task 99 not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Tasks"
        ],
        "summary": "Update a task",
        "description": "Send `title`, `done`, or both. Omitted fields are left unchanged.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Buy oat milk"
                  },
                  "done": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "The body was empty or a field had the wrong type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Tasks"
        ],
        "summary": "Delete a task",
        "responses": {
          "204": {
            "description": "Deleted. No content is returned."
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "tags": [
          "Meta"
        ],
        "summary": "Restore the three seed tasks",
        "description": "Throws away the current list and starts over. Handy for demos.",
        "responses": {
          "200": {
            "description": "The restored list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "done",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Buy milk"
          },
          "done": {
            "type": "boolean",
            "example": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was created, set by the database.",
            "example": "2026-07-31T18:23:49Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was last changed, set by the database on every update.",
            "example": "2026-07-31T18:23:50Z"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "you@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "password123"
          }
        }
      },
      "User": {
        "type": "object",
        "description": "The safe subset of the Supabase user. The full object carries identity records and app metadata that no client has a reason to see.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "9c8f0d2a-1b3e-4f5a-8c7d-6e5f4a3b2c1d"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "you@example.com"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "The JWT to send on protected routes. Short-lived \u2014 one hour by default.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "refresh_token": {
            "type": "string",
            "description": "Longer-lived token used to obtain a new access token without logging in again."
          },
          "token_type": {
            "type": "string",
            "example": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Seconds until the access token expires.",
            "example": 3600
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Task 99 not found"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "The `access_token` returned by `POST /auth/login`. Sent as `Authorization: Bearer <token>`. Supabase signs it and this API verifies it with Supabase on every request \u2014 a token altered by even one character is rejected."
      }
    }
  }
}
