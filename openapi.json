{
  "openapi": "3.0.3",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "description": "A small CRUD API for a to-do list. Tasks are stored in a PostgreSQL database running in a Docker container, so they survive a restart of the server and a rebuild of its container. The table is created and seeded automatically on first run. The whole stack starts with `docker compose up`."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Tasks",
      "description": "Create, read, update and delete tasks"
    },
    {
      "name": "Meta",
      "description": "Service information and health"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Describe the API",
        "responses": {
          "200": {
            "description": "Name, version and available endpoints",
            "content": {
              "application/json": {
                "example": {
                  "name": "Task API",
                  "version": "1.0",
                  "endpoints": [
                    "/tasks"
                  ],
                  "docs": "/docs"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Check that the server is alive and can reach its database",
        "description": "Runs `SELECT 1` against Postgres rather than only reporting that the process is running. This is the endpoint a load balancer or orchestrator polls: 200 means \"send me traffic\", 503 means \"take me out of rotation\".",
        "responses": {
          "200": {
            "description": "The server is up and the database answered",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "db": "ok"
                }
              }
            }
          },
          "503": {
            "description": "The server is running but cannot reach the database",
            "content": {
              "application/json": {
                "example": {
                  "status": "degraded",
                  "db": "unreachable",
                  "error": "connect ECONNREFUSED 127.0.0.1:5432"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Count tasks by state",
        "responses": {
          "200": {
            "description": "Totals computed from the current list",
            "content": {
              "application/json": {
                "example": {
                  "total": 3,
                  "done": 1,
                  "open": 2
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "List tasks",
        "description": "Returns every task. Use `done` and `search` to filter, `sort` to order them, and `limit`/`offset` to page through the results. All of it is done in SQL.",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "description": "Only return finished (`true`) or unfinished (`false`) tasks.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Only return tasks whose title contains this text (case-insensitive).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Order the results by insertion order (`id`, the default) or alphabetically by title (`title`, case-insensitive).",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "title"
              ],
              "default": "id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of tasks to return.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of tasks to skip before returning results.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "A query parameter was invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Create a task",
        "description": "The server assigns the id and sets `done` to false.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Buy milk"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Title is missing or empty",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Field \"title\" is required and must be a non-empty string"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The task's id.",
          "schema": {
            "type": "integer",
            "example": 1
          }
        }
      ],
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get one task",
        "responses": {
          "200": {
            "description": "The task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task 99 not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Tasks"
        ],
        "summary": "Update a task",
        "description": "Send `title`, `done`, or both. Omitted fields are left unchanged.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "example": "Buy oat milk"
                  },
                  "done": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "The body was empty or a field had the wrong type",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Tasks"
        ],
        "summary": "Delete a task",
        "responses": {
          "204": {
            "description": "Deleted. No content is returned."
          },
          "404": {
            "description": "No task with that id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "tags": [
          "Meta"
        ],
        "summary": "Restore the three seed tasks",
        "description": "Throws away the current list and starts over. Handy for demos.",
        "responses": {
          "200": {
            "description": "The restored list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "done",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Buy milk"
          },
          "done": {
            "type": "boolean",
            "example": false
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was created, set by the database.",
            "example": "2026-07-31T18:23:49Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the task was last changed, set by the database on every update.",
            "example": "2026-07-31T18:23:50Z"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Task 99 not found"
          }
        }
      }
    }
  }
}
